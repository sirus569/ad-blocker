{
  "manifest_version": 3,
  "name": "Kid Ad Shield",
  "version": "2.0.0",
  "minimum_chrome_version": "116",
  "description": "Covers the screen and mutes the sound during live YouTube TV commercial breaks (and labeled Prime Video ads), then brings the show back.",
  "permissions": [
    "storage",
    "tabCapture",
    "activeTab",
    "offscreen"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Kid Ad Shield"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.amazon.com/*",
        "https://*.primevideo.com/*",
        "https://tv.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://tv.youtube.com/*"
      ],
      "js": [
        "page-probe.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "http://127.0.0.1:8787/*"
  ]
}
